{
  "name": "newsorder",
  "version": "0.1.0",
  "private": true,
  "description": "뉴스, Reddit 토픽, 고전 소설을 문장 배열로 학습하는 비상업 영어 교육 서비스",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build": "pnpm --filter @newsorder/web build",
    "dev": "pnpm --filter @newsorder/web dev",
    "dev:web": "pnpm --filter @newsorder/web exec next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter @newsorder/web test:coverage",
    "test:e2e": "pnpm --filter @newsorder/web test:e2e",
    "db:generate": "pnpm --filter @newsorder/db db:generate",
    "db:migrate": "pnpm --filter @newsorder/db db:migrate",
    "db:check": "pnpm --filter @newsorder/db db:check",
    "restore": "pnpm --filter @newsorder/db restore"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3"
  }
}

# Runtime selection: fixture for local/CI, production for external services.
NEWSORDER_RUNTIME_MODE=fixture
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL. Use separate URLs for local, preview, and production.
DATABASE_URL=

# Better Auth and Google OAuth. Generate a high-entropy secret per environment.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=

# Scheduled jobs. Vercel sends this value as a Bearer token.
CRON_SECRET=

# Google Cloud Translation uses ADC/WIF; do not add a service-account JSON.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Gemini quality verification.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Daily Reddit community topic collection. Reddit support approved temporary
# HTML/RSS parsing while OAuth app creation is unavailable. Keep this identifying.
REDDIT_USER_AGENT=Sentence/0.1 personal-study topic collector (https://sentence.doowiki.dev)
REDDIT_SCRAPER_URL=https://newsorder-reddit-scraper.vercel.app/api
REDDIT_SUMMARIZER_PROVIDER=claude-then-codex
REDDIT_CODEX_MODEL=gpt-5.6-terra
REDDIT_CLAUDE_MODEL=sonnet
REDDIT_CODEX_CLI_PATH=codex
REDDIT_CLAUDE_CLI_PATH=claude
REDDIT_CLI_TIMEOUT_MS=240000
REDDIT_TOPICS_ENABLED=false

# Encrypted user/auth/progress backups in Private Vercel Blob.
BLOB_READ_WRITE_TOKEN=
BACKUP_ENCRYPTION_KEY=
DELETION_EVENT_HMAC_KEY=

# Optional error reporting. Session Replay remains disabled in code.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Local-only fixture admin preview. Never enable in production.
NEWSORDER_DEV_ADMIN=false

# Legacy CRA/Express rollback only. Keep values in the deployment environment.
REACT_APP_FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=https://bbcnews-ee071-default-rtdb.firebaseio.com
# Point to an untracked Firebase service-account JSON or use workload identity.
GOOGLE_APPLICATION_CREDENTIALS=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
